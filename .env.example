# =============================================================================
# Apex Retail Store Intelligence — Environment Variables
# =============================================================================
# Copy this file to .env and customise for your environment.
# Docker Compose sets DATABASE_URL automatically via its environment: block.

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# DOCKER MODE (set by docker-compose.yml — no change needed):
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/store_intelligence
#
# LOCAL DEV — SQLite (auto-selected when DATABASE_URL is unset):
#   Leave DATABASE_URL commented out, OR set it explicitly:
# DATABASE_URL=sqlite+aiosqlite:///./store_intelligence.db
#
# LOCAL DEV — Postgres (if you have a local Postgres instance):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/store_intelligence

# -----------------------------------------------------------------------------
# POS TRANSACTIONS
# -----------------------------------------------------------------------------
# Path to the POS CSV file used to seed purchase data.
POS_TRANSACTIONS_CSV=Brigade_Bangalore_10_April_26 (1)bc6219c.csv

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
PORT=8000
